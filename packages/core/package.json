{
  "name": "@dsh-guard/core",
  "version": "0.5.0-alpha.1",
  "description": "Static scanner, immutable artifact resolver, profile verifier, and installer for DSH Guard",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./action": {
      "types": "./lib/action/index.d.ts",
      "default": "./lib/action/index.js"
    },
    "./lifecycle": {
      "types": "./lib/lifecycle.d.ts",
      "default": "./lib/lifecycle.js"
    },
    "./state": {
      "types": "./lib/state.d.ts",
      "default": "./lib/state.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "clean": "rm -rf lib coverage tsconfig.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@npmcli/arborist": "^9.1.1",
    "@babel/parser": "^7.27.5",
    "npm-packlist": "^10.0.0",
    "semver": "^7.7.2",
    "tar": "^7.4.3",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/npm-packlist": "^7.0.0",
    "@types/semver": "^7.7.0"
  }
}
